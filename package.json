{
  "name": "melbourne-traffic-lab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "model:build": "python3 scripts/prepare-model.py && node scripts/compile-model.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.md",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.md"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
