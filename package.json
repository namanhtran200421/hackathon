{
  "name": "melbourne-traffic-lab",
  "version": "3.0.0",
  "private": true,
  "description": "Close a street in Melbourne's CBD and watch the traffic find another way. A NetLogo traffic model in the browser, with an Express server and a React page, written in TypeScript.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @traffic-lab/simulation && npm run dev -w @traffic-lab/server",
    "build": "npm run build -w @traffic-lab/simulation && npm run build -w @traffic-lab/web && npm run build -w @traffic-lab/server",
    "start": "npm run start -w @traffic-lab/server",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "model:map": "python3 packages/simulation/netlogo/tools/prepare_map.py",
    "model:desktop": "python3 packages/simulation/netlogo/tools/merge_code.py && python3 packages/simulation/netlogo/tools/build.py",
    "model:web": "npm run model -w @traffic-lab/simulation"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=22.12 <25"
  }
}
