  <previewCommands>setup repeat 600 [ go ]</previewCommands>
  <experiments>
    <experiment name="Collins St closure vs baseline (10 paired seeds)" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= warm-up-s + measure-s</exitCondition>
      <metrics>
        <metric>mean-trip-time-min</metric>
        <metric>mean-delay-min</metric>
        <metric>trips-done</metric>
        <metric>vehicle-hours</metric>
        <metric>queued-at-gates</metric>
        <metric>stranded-count</metric>
        <metric>street-flow &quot;Collins St&quot;</metric>
        <metric>street-flow &quot;Flinders Ln&quot;</metric>
        <metric>street-flow &quot;Little Collins St&quot;</metric>
        <metric>street-flow &quot;Flinders St&quot;</metric>
        <metric>street-flow &quot;Bourke St&quot;</metric>
        <metric>street-flow &quot;King St&quot;</metric>
        <metric>street-flow &quot;William St&quot;</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="closure-street">
          <value value="&quot;none&quot;"></value>
          <value value="&quot;Collins St&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="closure-block">
          <value value="4"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="closure-type">
          <value value="&quot;Full closure (both directions)&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="closure-start-min">
          <value value="0"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="seed" first="1" step="1" last="10"></steppedValueSet>
      </constants>
    </experiment>
    <experiment name="smoke test (short)" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="false">
      <setup>setup</setup>
      <go>go</go>
      <exitCondition>ticks &gt;= warm-up-s + measure-s</exitCondition>
      <metrics>
        <metric>mean-trip-time-min</metric>
        <metric>mean-delay-min</metric>
        <metric>trips-done</metric>
        <metric>vehicle-hours</metric>
        <metric>queued-at-gates</metric>
        <metric>stranded-count</metric>
        <metric>street-flow &quot;Collins St&quot;</metric>
        <metric>street-flow &quot;Flinders Ln&quot;</metric>
        <metric>street-flow &quot;Little Collins St&quot;</metric>
        <metric>street-flow &quot;Flinders St&quot;</metric>
        <metric>street-flow &quot;Bourke St&quot;</metric>
        <metric>street-flow &quot;King St&quot;</metric>
        <metric>street-flow &quot;William St&quot;</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="closure-street">
          <value value="&quot;none&quot;"></value>
          <value value="&quot;Collins St&quot;"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="warm-up-s">
          <value value="300"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="measure-s">
          <value value="900"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="fixed-seed?">
          <value value="true"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="seed">
          <value value="1"></value>
        </enumeratedValueSet>
      </constants>
    </experiment>
  </experiments>
