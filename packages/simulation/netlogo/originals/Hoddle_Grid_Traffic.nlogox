    <plot x="1336" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="s vs free flow" y="10" xMin="0.0" height="200" legend="false" xMax="100.0" yMin="0.0" width="260" xAxis="seconds" display="Trip delay (last 100 trips)">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="delay" color="-10899396" legend="true">
        <setup></setup>
        <update>if not empty? recent-delays [ plot mean recent-delays ]</update>
