{
  "name": "@traffic-lab/simulation",
  "version": "3.0.0",
  "private": true,
  "description": "The Melbourne traffic model: NetLogo source, map data, and its browser and Node runtime.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/loadInNode.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build --config build/vite.worker.config.ts",
    "model": "python3 build/prepare-model.py && tsx build/compile-model.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
