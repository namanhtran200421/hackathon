{
  "name": "@traffic-lab/server",
  "version": "3.0.0",
  "private": true,
  "description": "The Melbourne Traffic Lab web server (Express).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts --dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@traffic-lab/simulation": "*",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "vite": "^8.3.1"
  }
}
