; Public DTP data supplies relative demand timing and conservative signal matches.
; Absolute CBD entry demand, routes and signal phases remain assumptions.
to load-observed-data
  file-open "data/observed/profiles.txt"
  set observed-weekday file-read
  set observed-weekend file-read
  set observed-signal-points file-read
  set observed-data-version file-read
  file-close
  set active-demand-profile demand-profile
  set active-profile-start-hour profile-start-hour
  set observed-signal-count 0
end

to apply-observed-signals
  if use-observed-signals? [
    foreach observed-signal-points [point ->
      let target min-one-of nodes [distancexy item 0 point item 1 point]
      if target != nobody [
        if [distancexy item 0 point item 1 point] of target < 0.01 [
          ask target [set signalised? true]
          set observed-signal-count observed-signal-count + 1
        ]
      ]
    ]
  ]
end

to-report observed-demand-factor
  if active-demand-profile = "Flat (synthetic)" [report 1]
  let index floor (((active-profile-start-hour * 3600 + ticks) mod 86400) / 900)
  if active-demand-profile = "SCATS weekday" [report item index observed-weekday]
  report item index observed-weekend
end

to-report effective-arrivals-per-hour
  report demand-veh-per-hour * observed-demand-factor
end
