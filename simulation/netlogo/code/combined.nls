;; =====================================================================
;;  HODDLE GRID TRAFFIC MODEL  -  prototype v0.1
;;  Melbourne CBD road network, origin-destination demand, signals,
;;  hook turns, dynamic re-routing and road-closure scenarios.
;;
;;  Units: 1 tick = 1 second, 1 patch = 10 metres.
;;  Internally all distances are metres and speeds are metres/second.
;;
;;  Everything marked  [VERIFY]  is a placeholder assumption that should
;;  be replaced with real data (OSM / City of Melbourne / DTP SCATS).
;; =====================================================================

extensions [ table ]

breed [ nodes node ]            ;; intersections, entry/exit gates, car parks
breed [ cars car ]
breed [ map-labels map-label ]
breed [ painters painter ]
directed-link-breed [ roads road ]   ;; one directed link = one direction of one block

globals [
  selected-street selected-block baseline-signature baseline-summary
  generated-total completed-total run-finished? demand-seed
  ;; ---- real traffic (see real_traffic.nls) ----
  data-version signal-sites count-sites weekday-counts weekend-counts zone-groups
  weekday-trips weekend-trips weekday-scales weekend-scales
  active-day-type run-start-s trips-hour hour-trips hour-totals
  zone-points zone-set site-roads site-offsets site-shares site-approaches
  ;; ---- physical constants ----
  M-PER-PATCH        ;; metres per patch
  BLOCK-W            ;; centre-line distance between north-south streets (m)
  ROW-H              ;; centre-line distance between east-west streets incl. little streets (m)
  VEH-LEN            ;; vehicle length + standstill gap (m)
  ACCEL DECEL        ;; m/s^2
  INTERGREEN         ;; amber + all-red (s) between signal phases
  BIG                ;; "infinity"
  LITTLE-ST-KMH      ;; speed on little streets / laneways (km/h)   [VERIFY]
  GIVE-WAY-DELAY     ;; expected wait when giving way at an unsignalised junction (s)
  vmax               ;; speed limit (m/s)

  ;; ---- network configuration ----
  dests              ;; destination groups; a node's dest-id is its group, -1 if none
  gates carparks signals

  ;; ---- scenario state ----
  closure-applied? closure-desc
  baseline           ;; table link-key -> veh/h, survives SETUP so runs can be compared

  ;; ---- statistics (measurement window only) ----
  trips-done trip-time-sum delay-sum veh-seconds stranded-count
  recent-delays
  mouse-was-down?
]

nodes-own [
  map-id zone-group site-id
  node-kind          ;; "grid" "gate" "carpark"
  col row            ;; grid indices, -1 for non-grid nodes
  signalised?
  cycle-offset
  green-axis         ;; "EW" "NS" or "none" (intergreen)
  last-green
  dest-id            ;; index in DESTS, -1 if not a destination
  weight             ;; demand weight for gates and car parks
  gate-queue         ;; vehicles waiting to enter the CBD: list of [tick dest]
  hook-box           ;; cars waiting in the intersection to complete a hook turn
  dist-live dist-free dist-base   ;; travel time (s) from this node to every destination
  tmp-dist tmp-done?
]

roads-own [
  geometry seg-ends posted-speed within-site?
  street axis        ;; street name, "EW" / "NS" / "access"
  road-kind          ;; "main" "little" "gate" "access"
  rank               ;; priority at unsignalised junctions (higher = priority)
  trams?
  cars-allowed?
  seg                ;; block number along the street, 1..8 (0 for gate/access links)
  len                ;; metres
  lanes lanes-open closed?
  free-tt            ;; free-flow travel time incl. average signal delay (s)
  cost-live          ;; current estimated travel time (s)
  tt-ema             ;; smoothed observed travel time (s)
  lane-cars          ;; list (one per lane, 0 = kerbside) of lists of cars, front car first
  win-count          ;; vehicles that left this link during the measurement window
  base-count         ;; baseline veh/h for this link (from SAVE-BASELINE)
  partner            ;; the opposite-direction link, if any
]

cars-own [
  cur-link next-link lane pos speed
  dest informed?
  t-start t-link ff-time
  moved-at
  hooking            ;; node whose hook-box this car is waiting in, else nobody
  plan-next plan-for plan-lane
]

;; =====================================================================
;;  SETUP
;; =====================================================================

to setup
  ;; not CLEAR-ALL: the baseline table must survive between runs
  clear-ticks clear-turtles clear-patches clear-drawing clear-all-plots clear-output
  if fixed-seed? [ random-seed seed ]
  set run-finished? false
  set generated-total 0 set completed-total 0
  set demand-seed ifelse-value fixed-seed? [seed] [random 1000000]
  if not is-string? selected-street [set selected-street "Collins St"]
  setup-constants
  load-real-traffic
  set gates no-turtles
  set carparks no-turtles
  set signals no-turtles
  reset-ticks
  if baseline = 0 [ set baseline table:make ]
  set trips-done 0 set trip-time-sum 0 set delay-sum 0 set veh-seconds 0 set stranded-count 0
  set recent-delays []
  set mouse-was-down? false
  set closure-applied? false
  set closure-desc "none"
  resize-world -120 120 -102 102
  ask patches [set pcolor [22 29 39]]
  build-osm-network
  setup-count-sites
  if baseline-signature != scenario-signature [
    set baseline table:make
    set baseline-signature ""
    set baseline-summary []
  ]
  reset-ticks
  setup-signals
  setup-routing
  ask roads [ set base-count ifelse-value table:has-key? baseline link-key [ table:get baseline link-key ] [ 0 ] ]
  if scheduled-closure? and closure-start-min = 0 [ apply-scenario-closure ]
  update-link-colors
  output-print (word "Melbourne CBD traffic ready: " day-type " from " start-time ", shaped by SCATS counts.")
  output-print (word "Closure: " closure-desc)
end

to setup-constants
  set M-PER-PATCH 10
  set BLOCK-W 201.2
  set ROW-H 100.6
  set VEH-LEN 7
  set ACCEL 1.5
  set DECEL 3.5
  set INTERGREEN 6
  set BIG 1000000000
  set LITTLE-ST-KMH 20
  set GIVE-WAY-DELAY 6
  set vmax speed-limit-kmh / 3.6
end

;; ---------------------------------------------------------------------
;;  network construction
;; ---------------------------------------------------------------------

to init-node [kind]
  set map-id who
  set zone-group -1
  set site-id -1
  set node-kind kind
  set col -1 set row -1
  set signalised? false
  set green-axis "none" set last-green "none"
  set dest-id -1 set weight 0
  set gate-queue [] set hook-box []
  set cycle-offset 0
  set shape "circle" set size 1 set color gray
  set label ""
end

to make-road [a b nm ax kind tr? nl ok? sg]
  ask a [
    create-road-to b [
      set geometry (list (list [xcor] of a [ycor] of a) (list [xcor] of b [ycor] of b))
      set posted-speed speed-limit-kmh
      set within-site? false
      set street nm
      set axis ax
      set road-kind kind
      set rank (ifelse-value kind = "little" [ 1 ] kind = "access" [ 0 ] [ 2 ])
      set trams? tr?
      set cars-allowed? ok?
      set seg sg
      set len link-length * M-PER-PATCH
      set lanes nl
      set lanes-open nl
      set closed? false
      set lane-cars n-values nl [ [] ]
      set win-count 0
      set base-count 0
      set partner nobody
      set thickness base-thickness
      set color gray
    ]
  ]
end

to-report base-thickness  ;; link reporter
  report (ifelse-value road-kind = "main" or road-kind = "gate" [ 0.7 ] road-kind = "little" [ 0.35 ] [ 0.2 ])
end

;; ---------------------------------------------------------------------
;;  signals
;; ---------------------------------------------------------------------

to setup-signals
  set signals nodes with [ signalised? ]
  set site-offsets n-values length signal-sites [ 0 ]
  set site-shares n-values length signal-sites [ ew-green-share / 100 ]
  set site-approaches n-values length signal-sites [ no-links ]
  foreach sort remove-duplicates [ site-id ] of signals [ id ->
    let members signals with [ site-id = id ]
    let offset ifelse-value signal-coordination = "green wave (east-west)"
      [ (cycle-length * 100 - round (mean [col] of members * BLOCK-W / vmax)) mod cycle-length ]
      [ random cycle-length ]
    ask members [ set cycle-offset offset ]
    set site-offsets replace-item id site-offsets offset
    set site-approaches replace-item id site-approaches approaches-to members
  ]
  update-signals
  ask roads [
    set free-tt compute-free-tt
    set tt-ema free-tt
    set cost-live free-tt
  ]
end
to-report green-time-for [ax]
  let g-ew (cycle-length - 2 * INTERGREEN) * ew-green-share / 100
  report ifelse-value ax = "EW" [ g-ew ] [ cycle-length - 2 * INTERGREEN - g-ew ]
end

to-report compute-free-tt  ;; link reporter
  let t len / link-vmax
  if [signalised?] of end2 and axis != "access" and not within-site? [
    let red-frac 1 - green-time-for axis / cycle-length
    set t t + red-frac * red-frac * cycle-length / 2   ;; uniform-arrival delay (Webster, 1st term)
  ]
  let r rank
  if not [signalised?] of end2 and any? ([my-in-roads] of end2) with [ rank > r ] [
    set t t + GIVE-WAY-DELAY                            ;; expected wait to find a gap
  ]
  report t
end

to-report link-vmax  ;; link reporter
  report (ifelse-value
    road-kind = "access" [ 15 / 3.6 ]
    road-kind = "little" [ min list vmax (LITTLE-ST-KMH / 3.6) ]
    [ min (list vmax (posted-speed / 3.6)) ])
end

to update-signals
  if adaptive-signals? [
    (foreach range length site-offsets site-offsets [ [id offset] ->
      if (ticks + offset) mod cycle-length = 0 [
        set site-shares replace-item id site-shares demand-share item id site-approaches
      ]
    ])
  ]
  let usable cycle-length - 2 * INTERGREEN
  ask signals [
    let g-ew usable * ifelse-value adaptive-signals? [ item site-id site-shares ] [ ew-green-share / 100 ]
    let t (ticks + cycle-offset) mod cycle-length
    set green-axis (ifelse-value
      t < g-ew [ "EW" ]
      t < g-ew + INTERGREEN [ "none" ]
      t < usable + INTERGREEN [ "NS" ]
      [ "none" ])
    if green-axis != "none" [ set last-green green-axis ]
  ]
end
;; ---------------------------------------------------------------------
;;  routing: shortest travel time from every node to every destination
;; ---------------------------------------------------------------------

to setup-routing
  let D length dests
  ask nodes [
    set dist-live n-values D [ BIG ]
    set dist-free n-values D [ BIG ]
    set dist-base n-values D [ BIG ]
  ]
  compute-distances "base"   ;; network as built, no closures: reference for delay
  ask nodes [
    set dist-free dist-base
    set dist-live dist-base
  ]
end
;; mode: "base" ignores closures, "free" uses free-flow times, "live" uses current travel times
to compute-distances [mode]
  foreach range length dests [ k ->
    ask nodes [ set tmp-dist BIG set tmp-done? false ]
    ask nodes with [ dest-id = k ] [ set tmp-dist 0 ]
    let open-set nodes with [ dest-id = k ]
    while [ any? open-set ] [
      let u min-one-of open-set [ tmp-dist ]
      set open-set open-set with [ self != u ]
      ask u [ set tmp-done? true ]
      ;; never route THROUGH a gate or a car park
      if [dest-id] of u = k or [node-kind] of u = "grid" [
        let du [tmp-dist] of u
        ask [my-in-roads] of u [
          if mode-usable? mode [
            let v end1
            let nd du + (ifelse-value mode = "live" [ cost-live ] [ free-tt ])
            if not [tmp-done?] of v and nd < [tmp-dist] of v [
              ask v [ set tmp-dist nd ]
              set open-set (turtle-set open-set v)
            ]
          ]
        ]
      ]
    ]
    (ifelse
      mode = "live" [ ask nodes [ set dist-live replace-item k dist-live tmp-dist ] ]
      mode = "free" [ ask nodes [ set dist-free replace-item k dist-free tmp-dist ] ]
      [ ask nodes [ set dist-base replace-item k dist-base tmp-dist ] ])
  ]
end

to-report mode-usable? [mode]  ;; link reporter
  if mode = "base" [ report cars-allowed? ]
  report usable?
end

to-report usable?  ;; link reporter
  report cars-allowed? and not closed? and lanes-open > 0
end

to update-live-costs
  ask roads [
    let q 0
    foreach lane-cars [ lst -> set q q + length filter [ c -> [speed] of c < 1 ] lst ]
    let queue-delay 2.0 * q / max list 1 lanes-open
    set cost-live free-tt + max (list 0 (tt-ema - free-tt) queue-delay)
  ]
end

;; car reporter: best link to take at the downstream end of IN-L (nobody if IN-L ends at my destination)
to-report choose-from [in-l]
  let n [end2] of in-l
  if [dest-id] of n = dest [ report nobody ]
  let d dest
  let k dest
  let back-node [end1] of in-l
  let cands ([my-out-roads] of n) with [ usable? and ([node-kind] of end2 = "grid" or [dest-id] of end2 = d) ]
  let live? informed?
  set cands cands with [ifelse-value live? [item k [dist-live] of end2 < BIG] [item k [dist-free] of end2 < BIG]]
  if any? cands with [ end2 != back-node ] [ set cands cands with [ end2 != back-node ] ]   ;; no U-turns unless forced
  if not any? cands [ report nobody ]
  let best min-one-of cands [ choice-cost in-l live? k ]
  let dd ifelse-value live? [ item k [dist-live] of [end2] of best ] [ item k [dist-free] of [end2] of best ]
  if dd >= BIG [ report nobody ]
  report best
end

to-report choice-cost [in-l live? k]  ;; link reporter
  let c ifelse-value live? [ cost-live ] [ free-tt ]
  let d ifelse-value live? [ item k [dist-live] of end2 ] [ item k [dist-free] of end2 ]
  report (c + d + turn-penalty in-l self) * (1 + random-float route-noise)
end

to-report turn-type [in-l out-l]
  if in-l = nobody or out-l = nobody [ report "straight" ]
  let a subtract-headings ([link-heading] of out-l) ([link-heading] of in-l)
  if abs a < 30 [ report "straight" ]
  if abs a > 150 [ report "uturn" ]
  report ifelse-value a > 0 [ "right" ] [ "left" ]
end

to-report is-hook? [in-l out-l]  ;; the real map has no hook-turn locations
  report false
end
to-report turn-penalty [in-l out-l]
  let tt turn-type in-l out-l
  if tt = "straight" [ report 0 ]
  if tt = "left" [ report 3 ]
  if tt = "uturn" [ report 90 ]
  report ifelse-value is-hook? in-l out-l [ 25 ] [ 10 ]
end

;; =====================================================================
;;  GO
;; =====================================================================

to go
  if ticks >= warm-up-s + measure-s [ if not run-finished? [final-report set run-finished? true] stop ]
  if not closure-applied? and scheduled-closure? and ticks >= closure-start-min * 60 [
    apply-scenario-closure
  ]
  if ticks mod reroute-interval = 0 [
    update-live-costs
    compute-distances "live"
  ]
  update-signals
  generate-demand
  ask roads [ process-link ]
  process-hook-boxes
  if measuring? [ set veh-seconds veh-seconds + count cars + queued-at-gates ]
  if ticks mod 5 = 0 [ update-link-colors ]
  tick
end

to-report measuring?
  report ticks >= warm-up-s and ticks < warm-up-s + measure-s
end

to-report measured-seconds
  report max list 0 (min list (ticks - warm-up-s) measure-s)
end

;; ---------------------------------------------------------------------
;;  demand
;; ---------------------------------------------------------------------

to generate-demand
  refresh-trips
  let per-second slot-scale / 3600
  with-local-randomness [
    random-seed (demand-seed + ticks * 104729)
    (foreach zone-points hour-trips hour-totals [[z trips total] ->
      if total > 0 [
        repeat random-poisson (total * per-second) [
          set generated-total generated-total + 1
          let d pick-group trips total
          ifelse item d [dist-base] of z >= BIG [set stranded-count stranded-count + 1]
            [ask z [set gate-queue lput (list ticks d) gate-queue]]
        ]
      ]
    ])
  ]
  ask zone-set with [not empty? gate-queue] [try-release]
end
to try-release  ;; gate procedure
  let out one-of my-out-roads
  if out = nobody [stop]
  let waiting-dest item 1 first gate-queue
  if item waiting-dest dist-free >= BIG [
    set gate-queue but-first gate-queue
    set stranded-count stranded-count + 1
    stop
  ]
  if not [usable? and any-lane-room?] of out [stop]
  let entry first gate-queue
  set gate-queue but-first gate-queue
  let g self
  hatch-cars 1 [
    init-car g (item 1 entry) (item 0 entry)
    set next-link choose-from out
    ifelse next-link = nobody [
      set stranded-count stranded-count + 1
      die
    ] [
      let li entry-lane out next-link
      put-on-link out (max list 0 li) 0
    ]
  ]
end

to init-car [g d t0]
  set dest d
  set informed? random-float 100 < informed-drivers-%
  set t-start t0
  set ff-time item d ([dist-base] of g)
  if ff-time >= BIG [ set ff-time item d ([dist-free] of g) ]
  set moved-at ticks
  set hooking nobody
  set plan-for nobody
  set plan-next nobody
  set plan-lane 0
  set speed vmax * 0.6
  set shape "default"
  set size 1.3
  set label ""
  show-turtle
end

;; ---------------------------------------------------------------------
;;  vehicle movement
;; ---------------------------------------------------------------------

to process-link  ;; link procedure: move cars front-to-back in every lane
  let L self
  foreach lane-cars [ lst ->
    let leader nobody
    foreach lst [ c ->
      if c != nobody [
        if [moved-at] of c != ticks [ ask c [ step-car leader ] ]
        set leader c
      ]
    ]
  ]
end

to step-car [leader]  ;; car procedure
  set moved-at ticks
  let L cur-link
  let Llen [len] of L
  if leader != nobody [ if [cur-link] of leader != L [ set leader nobody ] ]
  let limit BIG
  let can-go? false
  let turn-cap BIG
  ifelse leader != nobody [
    set limit [pos] of leader - pos - VEH-LEN
  ] [
    let d-end Llen - pos
    if d-end < speed + 40 [
      ifelse may-pass? [
        set can-go? true
        if next-link != nobody and turn-type L next-link != "straight" [
          set turn-cap sqrt (36 + 2 * DECEL * d-end)   ;; slow to ~6 m/s for turns
        ]
      ] [
        set limit d-end - 0.5
      ]
    ]
  ]
  let v min (list (speed + ACCEL) ([link-vmax] of L) turn-cap)
  if limit < BIG [ set v min (list v (sqrt (2 * DECEL * max list 0 limit)) (max list 0 limit)) ]
  set speed max list 0 v
  set pos pos + speed
  ifelse pos >= Llen [
    ifelse can-go? [ do-transfer (pos - Llen) ] [ hold-at-line ]
  ] [
    if speed > 0 or color != 15 [ place-car ]
  ]
end

;; car reporter: may I cross the stop line at the end of my current link?
to-report may-pass?
  let L cur-link
  let n [end2] of L
  if next-link = nobody [ report true ]            ;; arriving (or stranded - handled on transfer)
  if not [usable?] of next-link [                  ;; road closed ahead: pick another way
    set next-link choose-from L
    set plan-for nobody
    if next-link = nobody [ report true ]
  ]
  let tt turn-type L next-link
  let hook? is-hook? L next-link
  let d-end [len] of L - pos

  ;; traffic signals
  if [signalised?] of n and not [within-site?] of L and [axis] of L != "access" [
    let g [green-axis] of n
    let my-axis [axis] of L
    if g != my-axis [
      let committed? g = "none" and [last-green] of n = my-axis and d-end < (speed * speed) / (2 * DECEL)
      let clearing-right? g = "none" and [last-green] of n = my-axis and tt = "right" and not hook? and d-end < 3
      if not (committed? or clearing-right?) [ report false ]
    ]
  ]
  ;; give way at unsignalised junctions
  if not [signalised?] of n or [axis] of L = "access" [
    let r [rank] of L
    if any? ([my-in-roads] of n) with [ rank > r and self != L and approaching-within 30 ] [ report false ]
  ]
  ;; right turns (non-hook) give way to oncoming traffic
  if tt = "right" and not hook? [
    let h [link-heading] of L
    let opp one-of ([my-in-roads] of n) with [ abs subtract-headings link-heading ((h + 180) mod 360) < 30 ]
    if opp != nobody [ if [approaching-within 40] of opp [ report false ] ]
  ]
  ;; space downstream (don't block the intersection)
  if hook? [ report length [hook-box] of n < 3 ]
  if plan-for != next-link [
    set plan-next choose-from next-link
    set plan-for next-link
  ]
  set plan-lane entry-lane next-link plan-next
  report plan-lane >= 0
end

to-report approaching-within [d]  ;; link reporter: is a moving car within D metres of the end?
  let result false
  foreach lane-cars [ lst ->
    if not empty? lst [
      let c first lst
      if c != nobody [
        if (len - [pos] of c) < d and [speed] of c > 1 [ set result true ]
      ]
    ]
  ]
  report result
end

to do-transfer [ov]  ;; car procedure
  let L cur-link
  if next-link = nobody [
    let arrived? [dest-id] of [end2] of L = dest
    leave-current
    finish-trip arrived?
    stop
  ]
  let n [end2] of L
  ifelse is-hook? L next-link [
    if length [hook-box] of n >= 3 [ hold-at-line stop ]
    leave-current
    set hooking n
    ask n [ set hook-box lput myself hook-box ]
    set speed 0
    let h [link-heading] of next-link
    move-to n
    set heading h
    setxy (xcor + 1.2 * sin (h - 90)) (ycor + 1.2 * cos (h - 90))
    set color 15
  ] [
    let li entry-lane next-link plan-next
    if li < 0 [ hold-at-line stop ]
    leave-current
    enter-link next-link li ov
  ]
end

to hold-at-line
  set pos [len] of cur-link - 0.01
  set speed 0
  place-car
end

to leave-current  ;; car procedure
  let L cur-link
  let li lane
  let me self
  let tt ticks - t-link
  let m? measuring?
  ask L [
    set lane-cars replace-item li lane-cars (remove me (item li lane-cars))
    set tt-ema 0.8 * tt-ema + 0.2 * tt
    if m? [ set win-count win-count + 1 ]
  ]
  set cur-link nobody
end

to enter-link [L2 li p]  ;; car procedure
  let nxt ifelse-value plan-for = L2 [ plan-next ] [ choose-from L2 ]
  put-on-link L2 li p
  set next-link nxt
  set plan-for nobody
  set plan-next nobody
end

to put-on-link [L li p]  ;; car procedure
  set cur-link L
  set lane li
  set t-link ticks
  let g entry-gap L li
  set pos max list 0 (min (list p g ([len] of L - 0.01)))
  ask L [ set lane-cars replace-item li lane-cars (lput myself (item li lane-cars)) ]
  place-car
end

to finish-trip [arrived?]
  ifelse arrived? [
    set completed-total completed-total + 1
    if measuring? [
      let tt ticks - t-start
      set trips-done trips-done + 1
      set trip-time-sum trip-time-sum + tt
      set delay-sum delay-sum + (tt - ff-time)
      set recent-delays lput (tt - ff-time) recent-delays
      if length recent-delays > 100 [ set recent-delays but-first recent-delays ]
    ]
  ] [
    set stranded-count stranded-count + 1
  ]
  die
end

;; ---- lanes ----

to-report entry-gap [L li]
  let lst item li [lane-cars] of L
  if empty? lst [ report BIG ]
  report [pos] of last lst - VEH-LEN
end

to-report lane-room? [L li]
  report entry-gap L li >= 0
end

to-report any-lane-room?  ;; link reporter
  let L self
  report reduce [ [a b] -> a or b ] (fput false map [ i -> lane-room? L i ] range lanes-open)
end

;; lane on link L for a car whose next move is N; -1 if no lane has room
to-report entry-lane [L N]
  let nl [lanes-open] of L
  if nl < 1 [ report -1 ]
  let pref 0
  if nl > 1 [
    let tt turn-type L N
    (ifelse
      tt = "left" or is-hook? L N [ set pref 0 ]
      tt = "right" [ set pref nl - 1 ]
      [ let counts map [ i -> length item i [lane-cars] of L ] range nl
        set pref position (min counts) counts ])
  ]
  if lane-room? L pref [ report pref ]
  foreach range nl [ i -> if lane-room? L i [ report i ] ]
  report -1
end

;; ---- hook turns: wait in the intersection, go when the cross street gets green ----

to process-hook-boxes
  ask signals with [ not empty? hook-box ] [
    let n self
    let c first hook-box
    ifelse c = nobody [
      set hook-box but-first hook-box
    ] [
      let out [next-link] of c
      if green-axis = [axis] of out [
        ask c [
          ifelse not [usable?] of out [
            ask n [ set hook-box but-first hook-box ]
            finish-trip false
          ] [
            set plan-next choose-from out
            set plan-for out
            let li entry-lane out plan-next
            if li >= 0 [
              ask n [ set hook-box but-first hook-box ]
              set hooking nobody
              enter-link out li 0
              set speed 3
            ]
          ]
        ]
      ]
    ]
  ]
end

to place-car
  let L cur-link
  let points [geometry] of L
  let ends [seg-ends] of L
  let d max list 0 pos
  let index 1
  let last-index length ends - 1
  while [index < last-index and d > item index ends] [set index index + 1]
  let a item (index - 1) points let b item index points
  let start item (index - 1) ends
  let f min list 1 ((d - start) / max list 0.001 (item index ends - start))
  let ddx item 0 b - item 0 a let ddy item 1 b - item 1 a
  let h atan ddx ddy
  let off 0.35 + ([lanes] of L - 1 - lane) * 0.35
  setxy (item 0 a + f * ddx + off * sin (h - 90)) (item 1 a + f * ddy + off * cos (h - 90))
  set heading h
  set color (ifelse-value speed < 0.5 [15] speed < vmax * 0.5 [25] [103])
end

to-report cumulative-lengths [points]  ;; metres from the start of a shape to each of its points
  let total 0
  let result [0]
  (foreach but-last points but-first points [[a b] ->
    set total total + point-distance a b
    set result lput total result
  ])
  report result
end

to-report point-along [points distance-m]
  let remaining max list 0 distance-m
  let index 0
  while [index < length points - 2 and remaining > point-distance (item index points) (item (index + 1) points)] [
    set remaining remaining - point-distance (item index points) (item (index + 1) points)
    set index index + 1
  ]
  let a item index points let b item (index + 1) points
  let segment-length point-distance a b
  let f min list 1 (remaining / max list 0.001 segment-length)
  let ddx item 0 b - item 0 a let ddy item 1 b - item 1 a
  report (list (item 0 a + f * ddx) (item 1 a + f * ddy) (atan ddx ddy))
end

to-report point-distance [a b]
  report 10 * sqrt ((item 0 b - item 0 a) ^ 2 + (item 1 b - item 1 a) ^ 2)
end
;; =====================================================================
;;  ROAD CLOSURES
;; =====================================================================

to choose-street
  if not any? roads [user-message "Click Setup first." stop]
  let names sort remove-duplicates [street] of roads with [road-kind != "gate" and road-kind != "access" and cars-allowed?]
  let picked user-one-of "Select a street" names
  if picked != false [set selected-street picked set selected-block 0]
end

to choose-section
  if not any? roads [stop]
  let numbers sort remove-duplicates [seg] of roads with [street = selected-street and road-kind != "gate" and road-kind != "access"]
  let options fput "Whole street" map [n -> word "Section " n] numbers
  let picked user-one-of (word selected-street ": choose extent (or click the map)") options
  if picked != false [
    ifelse picked = "Whole street" [set selected-block 0]
      [set selected-block item (position picked options - 1) numbers]
  ]
end

to-report selected-links
  report roads with [street = selected-street and cars-allowed? and road-kind != "gate" and road-kind != "access" and (selected-block = 0 or seg = selected-block)]
end

to-report selection-label
  report word selected-street (ifelse-value selected-block = 0 [" / whole street"] [word " / section " selected-block])
end

to apply-scenario-closure
  set closure-applied? true
  close-selection
end

to close-selection
  let targets selected-links
  if not any? targets [set closure-desc "No drivable road selected" stop]
  (ifelse
    closure-type = "Both directions" [ask targets [set closed? true set lanes-open 0]]
    closure-type = "East / north direction" [
      ask targets with [link-heading >= 315 or link-heading < 135] [set closed? true set lanes-open 0]
    ]
    [ask targets [set lanes-open max list 0 (lanes - 1) set closed? lanes-open = 0]])
  output-print (word "t=" ticks "s: " selection-label " / " closure-type)
  network-changed
end

to reopen-selection
  ask selected-links [set closed? false set lanes-open lanes]
  network-changed
end

to reopen-all
  ask roads [set closed? false set lanes-open lanes]
  set closure-applied? true
  network-changed
end

to network-changed
  compute-distances "free"
  update-live-costs
  compute-distances "live"
  ask cars [set plan-for nobody]
  set closure-desc (word count roads with [closed?] " closed directions; " count roads with [not closed? and lanes-open < lanes] " reduced lanes")
  update-link-colors
  display
end

; No STOP in the polling procedure: it must remain active between clicks.
to click-to-close
  handle-map-pointer mouse-down? mouse-inside? mouse-xcor mouse-ycor
end

to handle-map-pointer [pressed? inside? mx my]
  ifelse pressed? [
    if mouse-was-down? != true [
      set mouse-was-down? true
      if inside? and any? roads [
        let L min-one-of roads with [cars-allowed? and road-kind != "gate" and road-kind != "access"] [seg-distance mx my]
        if L != nobody [if [seg-distance mx my] of L < 2.5 [toggle-closure L]]
      ]
    ]
  ] [set mouse-was-down? false]
end

to toggle-closure [L]
  set selected-street [street] of L
  set selected-block ifelse-value close-whole-street? [0] [[seg] of L]
  ifelse [closed? or lanes-open < lanes] of L [reopen-selection] [close-selection]
end

to-report seg-distance [px py]
  let best 1.0E20
  let pts geometry
  (foreach (but-last pts) (but-first pts) [[a b] ->
    let x1 item 0 a let y1 item 1 a
    let ddx item 0 b - x1 let ddy item 1 b - y1
    let l2 ddx * ddx + ddy * ddy
    let t ifelse-value l2 = 0 [0] [((px - x1) * ddx + (py - y1) * ddy) / l2]
    set t max list 0 (min list 1 t)
    set best min list best sqrt ((px - x1 - t * ddx) ^ 2 + (py - y1 - t * ddy) ^ 2)
  ])
  report best
end

to-report scenario-signature
  report (list data-version day-type start-time informed-drivers-% speed-limit-kmh cycle-length ew-green-share adaptive-signals? signal-coordination fixed-seed? seed route-noise reroute-interval warm-up-s measure-s)
end

;; =====================================================================
;;  OUTPUT, BASELINE COMPARISON, DISPLAY
;; =====================================================================

to save-baseline
  if any? roads with [closed? or lanes-open < lanes] [
    user-message "Reopen all roads and run a fresh baseline before saving."
    stop
  ]
  if measured-seconds < 60 [
    user-message "Run past the warm-up period first (at least 1 minute of measurement)."
    stop
  ]
  set baseline-signature scenario-signature
  set baseline-summary (list trips-done mean-trip-time-min queued-at-gates stranded-count measured-seconds)
  set baseline table:make
  let hrs measured-seconds / 3600
  ask roads [
    table:put baseline link-key (win-count / hrs)
    set base-count win-count / hrs
  ]
  output-print (word "Baseline saved from this run (" closure-desc ").")
  output-print "Now set a closure, press SETUP and GO, then choose view-mode 'change vs baseline'."
end

to-report link-key  ;; link reporter
  report (word [map-id] of end1 "-" [map-id] of end2)
end

to update-link-colors
  let hrs max list (1 / 60) (measured-seconds / 3600)
  ask roads [
    set thickness base-thickness
    let p partner
    (ifelse
      not cars-allowed? [ set color 117 ]
      closed? or (p != nobody and [closed?] of p) [ set color 15 set thickness 1.4 ]
      lanes-open < lanes or (p != nobody and [lanes-open < lanes] of p) [ set color 125 set thickness 1.2 ]
      road-kind = "access" [ set color 6 ]
      view-mode = "congestion" [
        let occ link-occupancy
        if p != nobody [ set occ max list occ [link-occupancy] of p ]
        set color (ifelse-value occ < 0.1 [ 55 ] occ < 0.3 [ 44 ] occ < 0.6 [ 25 ] [ 14 ])
      ]
      view-mode = "volume" [
        let vol win-count + ifelse-value p != nobody [ [win-count] of p ] [ 0 ]
        set vol vol / hrs
        set color scale-color red vol 1800 0
        set thickness base-thickness + min list 1.5 (vol / 800)
      ]
      baseline-signature = "" [set color gray]
      [ ;; change vs baseline
        let vol win-count + ifelse-value p != nobody [ [win-count] of p ] [ 0 ]
        let base base-count + ifelse-value p != nobody [ [base-count] of p ] [ 0 ]
        let diff vol / hrs - base
        set color (ifelse-value diff > 25 [ 15 ] diff < -25 [ 105 ] [ 5 ])
        set thickness base-thickness + min list 2 (abs diff / 250)
      ])
  ]
  draw-osm-roads
end

to-report link-occupancy  ;; link reporter: share of storage space in use
  let n sum map length lane-cars
  report n / max list 1 (len * lanes-open / VEH-LEN)
end

to final-report
  output-print "------------------------------------------"
  output-print (word "Run finished. Closure: " closure-desc)
  output-print (word "Trips completed in window: " trips-done)
  output-print (word "Mean trip time (min): " precision mean-trip-time-min 2)
  output-print (word "Mean delay vs free flow (min): " precision mean-delay-min 2)
  output-print (word "Vehicle-hours in system: " precision vehicle-hours 1)
  output-print (word "Still waiting to enter: " queued-at-gates)
  output-print (word "Stranded / unroutable: " stranded-count)
end

to export-link-results
  let fname "combined-link-results.csv"
  carefully [ file-delete fname ] [ ]
  file-open fname
  file-print "street,direction,block,from,to,lanes,lanes_open,closed,veh_per_hour,baseline_veh_per_hour,change_veh_per_hour,mean_travel_time_s"
  let hrs max list (1 / 3600) (measured-seconds / 3600)
  foreach sort roads [ L ->
    ask L [
      if cars-allowed? and road-kind != "access" [
        file-print (word "\"" street "\"," direction-name "," seg ",\"" node-name end1 "\",\"" node-name end2 "\"," lanes "," lanes-open "," closed? ","
          precision (win-count / hrs) 1 "," precision base-count 1 "," precision (win-count / hrs - base-count) 1 "," precision tt-ema 1)
      ]
    ]
  ]
  file-close
  output-print (word "Link results written to " fname " (in the model's folder).")
end

to-report direction-name  ;; link reporter
  let h link-heading
  report (ifelse-value abs subtract-headings h 90 < 45 [ "EB" ] abs subtract-headings h 270 < 45 [ "WB" ] abs subtract-headings h 0 < 45 [ "NB" ] [ "SB" ])
end

to-report node-name [n]
  report (word [node-kind] of n " " [map-id] of n)
end
;; ---- reporters for monitors and BehaviorSpace ----

to-report mean-trip-time-min
  report ifelse-value trips-done > 0 [ trip-time-sum / trips-done / 60 ] [ 0 ]
end

to-report mean-delay-min
  report ifelse-value trips-done > 0 [ delay-sum / trips-done / 60 ] [ 0 ]
end

to-report vehicle-hours
  report veh-seconds / 3600
end

to-report queued-at-gates
  report sum [ length gate-queue ] of zone-set
end

to-report sim-clock
  let s ticks
  report (word floor (s / 60) " min " (s mod 60) " s")
end

;; average vehicles per hour through one block of street NM (both directions)
to-report street-flow [nm]
  let Ls roads with [ street = nm and road-kind != "gate" and cars-allowed? ]
  if not any? Ls or measured-seconds = 0 [ report 0 ]
  let nsegs length remove-duplicates [ seg ] of Ls
  report (sum [ win-count ] of Ls) / nsegs / (measured-seconds / 3600)
end

; Real road geometry, directed topology and available OSM lane/speed tags.
; Traffic enters and leaves where real roads cross the map's edge and parks in
; real public car parks. Traffic lights stand at the DTP signal sites.
to build-osm-network
  file-open "data/map.txt"
  let node-data file-read
  let edge-data file-read
  let entry-data file-read
  let car-park-data file-read
  file-close
  foreach node-data [row-data ->
    create-nodes 1 [
      init-node "grid"
      set map-id item 0 row-data
      setxy item 1 row-data item 2 row-data
      set col (xcor + 120) / 20
      set row (ycor + 102) / 10
      hide-turtle
    ]
  ]
  foreach edge-data [entry ->
    let a node item 0 entry let b node item 1 entry
    let nm item 2 entry
    let h [towards b] of a
    let ax ifelse-value (abs (sin h) > abs (cos h)) ["EW"] ["NS"]
    let little? (position "Little " nm = 0) or nm = "Flinders Ln"
    make-road a b nm ax (ifelse-value little? ["little"] ["main"]) false (item 5 entry) true 0
    ask road [who] of a [who] of b [
      set len item 3 entry
      set posted-speed item 4 entry
      set geometry item 6 entry
    ]
  ]
  ; Assign repeatable section IDs; opposite directions share the same section.
  foreach sort remove-duplicates [street] of roads [nm ->
    let keys [] let index 0
    foreach sort roads with [street = nm] [L ->
      let pair sort (list [who] of [end1] of L [who] of [end2] of L)
      if not member? pair keys [set keys lput pair keys set index index + 1]
      ask L [set seg 1 + position pair keys]
    ]
  ]
  ; Each DTP signal site controls one or more junctions.
  (foreach signal-sites range length signal-sites [[junctions id] ->
    foreach junctions [i -> ask node i [set signalised? true set site-id id]]
  ])
  ask roads [set within-site? [site-id] of end1 >= 0 and [site-id] of end1 = [site-id] of end2]
  foreach entry-data [crossing -> make-entry crossing]
  foreach car-park-data [car-park -> make-car-park car-park]
  set gates nodes with [node-kind = "gate"]
  set carparks nodes with [node-kind = "carpark"]
  ; Places where trips start, in the order the trip data lists them.
  set zone-points sort (turtle-set gates carparks)
  set zone-set turtle-set zone-points
  (foreach zone-points zone-groups [[z g] ->
    ask z [
      set zone-group g
      if g >= 0 and any? my-in-roads [set dest-id g]
    ]
  ])
  set dests range (1 + max zone-groups)
  ask roads [
    set partner road [who] of end2 [who] of end1
    set seg-ends cumulative-lengths geometry
    hide-link
  ]
  foreach ["Flinders St" "Collins St" "Bourke St" "Lonsdale St" "La Trobe St" "King St" "Spencer St" "William St" "Queen St" "Elizabeth St" "Russell St" "Exhibition St" "Spring St"] [nm ->
    let L max-one-of roads with [street = nm] [len]
    if L != nobody [
      let pt point-along [geometry] of L ([len] of L / 2)
      create-map-labels 1 [setxy item 0 pt item 1 pt set size 0 set label nm set label-color white]
    ]
  ]
  create-map-labels 1 [setxy 116 -98 set size 0 set label "© OpenStreetMap contributors | P = car park | N ↑" set label-color gray]
end

; A road crossing the map's edge: [junction x y street speed lanes-in lanes-out type].
; Traffic enters on the lanes coming in and leaves on the lanes going out.
to make-entry [details]
  let n node item 0 details
  let g nobody
  create-nodes 1 [
    init-node "gate"
    setxy item 1 details item 2 details
    set shape "square" set size 2 set color 3
    set g self
  ]
  let ax ifelse-value abs ([xcor] of n - [xcor] of g) > abs ([ycor] of n - [ycor] of g) ["EW"] ["NS"]
  if item 5 details > 0 [
    make-road g n (item 3 details) ax "gate" false (item 5 details) true 0
    ask road [who] of g [who] of n [set posted-speed item 4 details]
  ]
  if item 6 details > 0 [
    make-road n g (item 3 details) ax "gate" false (item 6 details) true 0
    ask road [who] of n [who] of g [set posted-speed item 4 details]
  ]
end

; Public car parks from OpenStreetMap that share a junction: [junction x y name count].
; Each car park has its own driveway, so the group gets one lane per car park, up to three.
to make-car-park [details]
  let n node item 0 details
  let p nobody
  create-nodes 1 [
    init-node "carpark"
    setxy item 1 details item 2 details
    set shape "square" set size 1.5 set color sky
    set label "P" set label-color white
    set p self
  ]
  let driveways min list 3 item 4 details
  make-road p n "Car park access" "access" "access" false driveways true 0
  make-road n p "Car park access" "access" "access" false driveways true 0
end

to draw-osm-roads
  clear-drawing
  create-painters 1 [
    hide-turtle
    foreach sort roads [L ->
      let pts [geometry] of L
      set color [color] of L
      set pen-size max list 1 ([thickness] of L * 3)
      pen-up setxy item 0 first pts item 1 first pts pen-down
      foreach but-first pts [pt -> setxy item 0 pt item 1 pt]
      pen-up
    ]
    die
  ]
end

; Real traffic from Victoria's public SCATS counts, prepared by
; simulation/build/prepare-observed.py. Traffic lights stand at the DTP signal
; sites. Trips start and end where real roads cross the map's edge and at
; public car parks, as many as the counts show for the chosen day and time.
; Traffic light timings are not in the data and remain assumed.

to load-real-traffic
  file-open "data/observed/demand.txt"
  set data-version file-read
  set signal-sites file-read
  set count-sites file-read
  set weekday-counts file-read
  set weekend-counts file-read
  set zone-groups file-read
  set weekday-trips file-read
  set weekend-trips file-read
  set weekday-scales file-read
  set weekend-scales file-read
  file-close
  set active-day-type day-type
  ; The clock starts one warm-up before the chosen time, so counting starts at it.
  set run-start-s (start-seconds - warm-up-s) mod 86400
  set trips-hour -1
end

; The chosen start time, such as "08:15", in seconds after midnight.
to-report start-seconds
  report 3600 * digits-at 0 + 60 * digits-at 3
end

; The two-digit number at position AT of start-time, such as 8 for "08".
; (read-from-string needs the NetLogo compiler, which the web page does not load.)
to-report digits-at [at]
  report 10 * position (item at start-time) "0123456789" + position (item (at + 1) start-time) "0123456789"
end

; The model's time of day, in seconds after midnight.
to-report clock-seconds
  report (run-start-s + ticks) mod 86400
end

to-report clock-label
  let minutes floor (clock-seconds / 60)
  report (word two-digits floor (minutes / 60) ":" two-digits (minutes mod 60))
end

to-report two-digits [n]
  report ifelse-value n < 10 [word "0" n] [word "" n]
end

; When the hour changes, look up that hour's trips: for each place trips can
; start, a list of [group trips-per-hour].
to refresh-trips
  let hour floor (clock-seconds / 3600)
  if hour != trips-hour [
    set trips-hour hour
    set hour-trips item hour (ifelse-value active-day-type = "Weekday" [weekday-trips] [weekend-trips])
    set hour-totals map [trips -> sum map [pair -> item 1 pair] trips] hour-trips
  ]
end

; Within the hour, trips rise and fall with the 15-minute counts.
to-report slot-scale
  report item floor (clock-seconds / 900) (ifelse-value active-day-type = "Weekday" [weekday-scales] [weekend-scales])
end

; Trips per hour starting right now, across the whole map. Only reads data,
; so watching it never changes the model.
to-report trips-per-hour-now
  let rows item floor (clock-seconds / 3600) (ifelse-value active-day-type = "Weekday" [weekday-trips] [weekend-trips])
  report sum map [trips -> sum map [pair -> item 1 pair] trips] rows * slot-scale
end

; A destination group for one trip, chosen in proportion to the trips per hour.
to-report pick-group [trips total]
  let r random-float total
  foreach trips [pair ->
    set r r - item 1 pair
    if r < 0 [report item 0 pair]
  ]
  report item 0 last trips
end

; The roads entering each counted site, from junctions outside the site.
to setup-count-sites
  set site-roads map [site -> roads-into item 2 site] count-sites
end

to-report roads-into [junctions]
  let members turtle-set map [i -> node i] junctions
  report (link-set [my-in-roads] of members) with [not member? end1 members]
end

; Vehicles per hour entering each counted site while counting.
to-report site-volumes
  let hrs measured-seconds / 3600
  if hrs <= 0 [report map [rs -> 0] site-roads]
  report map [rs -> sum [win-count] of rs / hrs] site-roads
end

; The SCATS counts for the same stretch of the day as the counting, in
; vehicles per hour: each 15 minutes weighted by how much of it was counted.
to-report counted-volumes
  let table ifelse-value active-day-type = "Weekday" [weekday-counts] [weekend-counts]
  let start run-start-s + warm-up-s
  let finish start + measured-seconds
  if finish <= start [report item (floor (start / 900) mod 96) table]
  let totals map [v -> 0] item 0 table
  let t start
  while [t < finish] [
    let part (min list ((floor (t / 900) + 1) * 900) finish) - t
    let slot-counts item (floor (t / 900) mod 96) table
    set totals (map [[a b] -> a + b * part] totals slot-counts)
    set t t + part
  ]
  report map [a -> a / (finish - start)] totals
end

; The GEH statistic traffic engineers use to compare hourly flows: under 5 is
; a good match.
to-report geh [modelled counted]
  if modelled + counted = 0 [report 0]
  report sqrt (2 * (modelled - counted) ^ 2 / (modelled + counted))
end

; How the model compares with SCATS so far: sites compared, sites within
; GEH 5, and total vehicles per hour entering them in the model and counted.
to-report scats-comparison
  let modelled site-volumes
  let counted counted-volumes
  let within length filter [g -> g < 5] (map [[m c] -> geh m c] modelled counted)
  report (list length modelled within sum modelled sum counted)
end

; The same comparison as a percentage, for the desktop monitor.
to-report scats-match
  if measured-seconds < 60 [report "counting…"]
  let result scats-comparison
  report (word round (100 * item 1 result / max list 1 item 0 result) "% of " item 0 result " sites")
end

; Traffic lights. SCATS gives each approach green time by demand; with
; adaptive-signals? on, each intersection shares its green time between
; east-west and north-south by the cars on its approaches at the start of
; each cycle, never giving either less than a fifth.
to-report approaches-to [members]
  report (link-set [my-in-roads] of members) with [not within-site? and axis != "access"]
end

to-report demand-share [approaches]
  let ew sum [sum map length lane-cars] of approaches with [axis = "EW"]
  let ns sum [sum map length lane-cars] of approaches with [axis = "NS"]
  report max list 0.2 (min list 0.8 ((ew + 1) / (ew + ns + 2)))
end
