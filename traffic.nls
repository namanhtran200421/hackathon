; Melbourne CBD traffic sandbox. Map: OpenStreetMap contributors (ODbL).
; 1 tick = 1 second; 1 world unit = 10 metres. Synthetic traffic only.
breed [junctions junction]
breed [cars car]
breed [labels label-marker]
directed-link-breed [roads road]
globals [completed total-trip-time failed-trips mouse-was-down selected-road selected-street]
junctions-own [osm-id signal? search-cost previous-node]
roads-own [street metres speed-kmh closed?]
cars-own [route current-road progress born speed-ms destination]

to setup
  clear-all
  set selected-street "Collins Street"
  random-seed seed-value
  ask patches [set pcolor [22 29 39]]
  file-open "data/network.txt"
  let node-data file-read
  let edge-data file-read
  let label-data file-read
  file-close
  foreach node-data [ row ->
    create-junctions 1 [
      set osm-id item 0 row
      setxy item 1 row item 2 row
      set signal? false
      hide-turtle
    ]
  ]
  foreach edge-data [row ->
    let a junction (item 0 row)
    let b junction (item 1 row)
    ask a [create-road-to b [
      set street item 2 row
      set metres item 3 row
      set speed-kmh item 4 row
      set closed? false
      set color [105 119 135]
      set thickness 0.55
    ]]
  ]
  ; Synthetic signals at branching junctions, NOT actual signal locations/timings.
  ask junctions with [count link-neighbors >= 3] [set signal? true]
  foreach label-data [row ->
    create-labels 1 [setxy item 0 row item 1 row set label item 2 row
      set label-color [191 203 215] set size 0]
  ]
  create-labels 1 [setxy 115 95 set size 0 set label "MELBOURNE CBD | N ↑" set label-color white]
  create-labels 1 [setxy 115 -96 set size 0 set label "© OpenStreetMap contributors · synthetic traffic" set label-color gray]
  set selected-road nobody
  set mouse-was-down false
  reset-ticks
  repeat initial-cars [spawn-car]
end

to go
  if not any? junctions [stop]
  if random-float 1 < arrivals-per-minute / 60 [spawn-car]
  ask cars [move-car]
  tick
end

to spawn-car
  let origin one-of junctions
  let target one-of junctions with [self != origin and distance origin > 50]
  if target = nobody [stop]
  let planned find-route origin target
  if length planned < 2 [set failed-trips failed-trips + 1 stop]
  let first-edge [out-road-to (item 1 planned)] of origin
  ; Do not insert a car on top of another car at the source.
  if any? cars with [current-road = first-edge and progress < 8] [stop]
  create-cars 1 [
    set route but-first planned
    set destination target
    set current-road first-edge
    set progress 0
    set born ticks
    set speed-ms 0
    set shape "car"
    set size 1.6
    set color one-of [cyan sky yellow white]
    move-to origin
    position-car
  ]
end

to move-car
  set speed-ms 0
  if current-road = nobody [stop]
  ; Cars already in a newly closed segment can finish that segment.
  let road-length [metres] of current-road
  let permitted [speed-kmh] of current-road / 3.6
  let ahead cars with [self != myself and current-road = [current-road] of myself and progress > [progress] of myself]
  if any? ahead [set permitted min (list permitted (max (list 0 (min [progress] of ahead - progress - 7))))]
  let end-node [end2] of current-road
  if signals? and [signal?] of end-node [
    let travel-heading [towards end-node] of ([end1] of current-road)
    let east-west? abs (sin travel-heading) > abs (cos travel-heading)
    let phase floor (ticks / signal-seconds) mod 2
    if (east-west? and phase = 0) or (not east-west? and phase = 1) [
      set permitted min (list permitted (max (list 0 (road-length - progress - 2))))
    ]
  ]
  set speed-ms max (list 0 permitted)
  set progress min (list road-length (progress + speed-ms))
  position-car
  if progress >= road-length [
    if end-node = destination [
      set completed completed + 1
      set total-trip-time total-trip-time + ticks - born + 1
      die
    ]
    set route but-first route
    if empty? route [set failed-trips failed-trips + 1 die]
    let next-edge [out-road-to (first [route] of myself)] of end-node
    if next-edge = nobody or [closed?] of next-edge [
      let replanned find-route end-node destination
      if length replanned < 2 [set failed-trips failed-trips + 1 die]
      set route but-first replanned
      set next-edge [out-road-to (first [route] of myself)] of end-node
    ]
    ifelse any? other cars with [current-road = next-edge and progress < 7]
      [set speed-ms 0 set route fput end-node route]
      [set current-road next-edge set progress 0 position-car]
  ]
end

to position-car
  let a [end1] of current-road
  let b [end2] of current-road
  let fraction progress / [metres] of current-road
  set heading [towards b] of a
  ; Offset to the left of travel, representing Australian left-hand traffic.
  let offset 0.20
  setxy ([xcor] of a + fraction * ([xcor] of b - [xcor] of a) - offset * cos heading)
        ([ycor] of a + fraction * ([ycor] of b - [ycor] of a) + offset * sin heading)
end

to-report find-route [origin target]
  ; A* routing on directed OSM edges, distance weighted; ignores closed edges.
  ask junctions [set search-cost 1.0E20 set previous-node nobody]
  ask origin [set search-cost 0]
  let frontier (turtle-set origin)
  let reached? false
  while [any? frontier and not reached?] [
    let current min-one-of frontier [search-cost + 10 * distance target]
    set frontier frontier with [self != current]
    ifelse current = target [set reached? true] [
      ask [my-out-roads with [not closed?]] of current [
        let candidate [end2] of self
        let new-cost [search-cost] of current + metres
        if new-cost < [search-cost] of candidate [
          ask candidate [set search-cost new-cost set previous-node current]
          set frontier (turtle-set frontier candidate)
        ]
      ]
    ]
  ]
  if not reached? [report []]
  let result (list target)
  let cursor target
  while [cursor != origin] [
    set cursor [previous-node] of cursor
    set result fput cursor result
  ]
  report result
end

to inspect-map
  ; Never STOP here: STOP would turn off the forever button while it waits.
  handle-map-pointer mouse-down? mouse-inside? mouse-xcor mouse-ycor
end

to handle-map-pointer [pressed? inside? pointer-x pointer-y]
  ifelse pressed? [
    if mouse-was-down != true [
      set mouse-was-down true
      if inside? and any? roads [toggle-road-at pointer-x pointer-y]
    ]
  ] [set mouse-was-down false]
end

to toggle-road-at [pointer-x pointer-y]
  set selected-road min-one-of roads [distance-to-point pointer-x pointer-y]
  if selected-road = nobody [stop]
  if [distance-to-point pointer-x pointer-y] of selected-road > 3 [
    set selected-road nobody
    stop
  ]
  let road-name [street] of selected-road
  set selected-street road-name
  ifelse close-whole-street? [
    let new-state not [closed?] of selected-road
    ask roads with [street = road-name] [set closed? new-state]
  ] [
    let a [end1] of selected-road
    let b [end2] of selected-road
    let new-state not [closed?] of selected-road
    ask roads with [(end1 = a and end2 = b) or (end1 = b and end2 = a)] [set closed? new-state]
  ]
  recolour-roads
  display
end

to-report distance-to-point [pointer-x pointer-y]
  let ax [xcor] of end1 let ay [ycor] of end1
  let delta-x [xcor] of end2 - ax let delta-y [ycor] of end2 - ay
  let ratio max (list 0 (min (list 1 (((pointer-x - ax) * delta-x + (pointer-y - ay) * delta-y) / (delta-x * delta-x + delta-y * delta-y)))))
  report sqrt ((pointer-x - ax - ratio * delta-x) ^ 2 + (pointer-y - ay - ratio * delta-y) ^ 2)
end

to reopen-all
  ask roads [set closed? false]
  recolour-roads
end

to close-collins
  ask roads with [street = "Collins Street"] [set closed? true]
  recolour-roads
end

to recolour-roads
  ask roads [set color ifelse-value closed? [red] [[105 119 135]]
    set thickness ifelse-value closed? [0.9] [0.55]]
end

to-report average-trip-seconds
  if completed = 0 [report 0]
  report total-trip-time / completed
end

; Selection is explicit: no chooser widget is required to compile the code.
to choose-street
  if not any? roads [user-message "Click Setup first." stop]
  let choices sort remove-duplicates [street] of roads with [street != "Unnamed road"]
  let picked user-one-of "Choose a street to close or reopen" choices
  if picked != false [set selected-street picked]
end
to close-selected-street
  ask roads with [street = selected-street] [set closed? true]
  recolour-roads
end

to reopen-selected-street
  ask roads with [street = selected-street] [set closed? false]
  recolour-roads
end

to-report selected-street-status
  let segments roads with [street = selected-street]
  if not any? segments [report "Click Setup first"]
  if all? segments [closed?] [report "Closed"]
  if any? segments with [closed?] [report "Partly closed"]
  report "Open"
end

to-report closed-streets
  report sort remove-duplicates [street] of roads with [closed?]
end

to list-closures
  ifelse empty? closed-streets
    [user-message "No streets are closed."]
    [user-message (word "Streets with closed segments:\n" reduce [[a b] -> word a (word "\n" b)] closed-streets)]
end
